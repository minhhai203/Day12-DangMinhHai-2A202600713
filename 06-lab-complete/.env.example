# Copy to .env for local Docker Compose. Never commit the real .env file.
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=false

APP_NAME=Day 12 Production Agent
APP_VERSION=1.0.0

# The lab uses a mock LLM and does not require a paid provider.
OPENAI_API_KEY=
LLM_MODEL=mock-llm

AGENT_API_KEY=replace-with-a-long-random-secret
RATE_LIMIT_PER_MINUTE=10
MONTHLY_BUDGET_USD=10.0

REDIS_URL=redis://redis:6379/0
SESSION_TTL_SECONDS=86400
MAX_HISTORY_MESSAGES=20

ALLOWED_ORIGINS=*
